---
import CarruselBase from "./CarruselBase.astro";
import CircuitosDecorativos from "./CircuitosDecorativos.astro";

interface Accion {
  texto: string;
  href: string;
  secundaria?: boolean;
}

interface Diapositiva {
  imagen: string;
  alt: string;
  nombre: string;
  titulo: string;
  destacado?: string;
  descripcion: string;
  acciones: Accion[];
}

interface Props {
  diapositivas: Diapositiva[];
  id?: string;
}

const { diapositivas, id } = Astro.props;
const imagenes = diapositivas.map(({ imagen, alt, nombre }) => ({
  src: imagen,
  alt,
  nombre,
}));
---

<CarruselBase
  imagenes={imagenes}
  id={id}
  labelledby="portada-titulo"
  etiquetaControl="diapositiva"
>
  <div class="contenedor-pagina relative z-10 w-full">
    {
      diapositivas.map((diapositiva, indice) => (
        <div
          class:list={[
            "portada-contenido-slide grid grid-cols-[1.2fr_.8fr] items-center gap-14 py-16 max-[820px]:grid-cols-1 max-[820px]:gap-8 max-[820px]:py-10",
            indice === 0
              ? ""
              : "pointer-events-none absolute inset-x-0 top-1/2 -translate-y-1/2 opacity-0",
          ]}
          data-portada-content
          data-active={indice === 0 ? "true" : "false"}
        >
          <div class="max-[820px]:order-2 max-[820px]:text-center">
            {indice === 0 ? (
              <h1
                class="mb-6 max-w-[780px] font-heading text-[clamp(2.35rem,5vw,4.4rem)] font-semibold leading-[1.08] tracking-[-.025em]"
                id="portada-titulo"
              >
                {diapositiva.titulo}{" "}
                {diapositiva.destacado && (
                  <span class="text-sky">{diapositiva.destacado}</span>
                )}
              </h1>
            ) : (
              <h2 class="mb-6 max-w-[780px] font-heading text-[clamp(2.35rem,5vw,4.4rem)] font-semibold leading-[1.08] tracking-[-.025em]">
                {diapositiva.titulo}{" "}
                {diapositiva.destacado && (
                  <span class="text-sky">{diapositiva.destacado}</span>
                )}
              </h2>
            )}
            <p class="mb-8 max-w-[620px] text-[clamp(1rem,1.45vw,1.08rem)] font-normal leading-[1.7] text-ice">
              {diapositiva.descripcion}
            </p>
            <div class="flex flex-wrap gap-3 max-[820px]:justify-center">
              {diapositiva.acciones.map((accion) => (
                <a
                  class:list={[
                    accion.secundaria ? "boton-secundario" : "boton-principal",
                    "gap-6",
                  ]}
                  href={accion.href}
                >
                  {accion.texto}{" "}
                  <span aria-hidden="true">
                    {accion.secundaria ? "↗" : "↓"}
                  </span>
                </a>
              ))}
            </div>
          </div>
          <div class="relative grid min-h-[19rem] place-items-center max-[820px]:order-1 max-[820px]:min-h-0">
            <CircuitosDecorativos id={`resplandor-portada-${indice}`} />
            <img
              class="relative z-10 w-[min(78%,22rem)] object-contain drop-shadow-[0_16px_28px_#001e3a55] max-[820px]:w-[min(42vw,11rem)]"
              src="/escudo-infosis.webp"
              alt=""
              width="500"
              height="500"
              loading={indice === 0 ? "eager" : "lazy"}
              decoding="async"
            />
          </div>
        </div>
      ))
    }
  </div>
</CarruselBase>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-carrusel-base]")
    .forEach((carrusel) => {
      const contenidos = Array.from(
        carrusel.querySelectorAll<HTMLElement>("[data-portada-content]"),
      );
      const mostrar = (indice: number) => {
        contenidos.forEach((contenido, posicion) => {
          const visible = posicion === indice;
          contenido.dataset.active = String(visible);
          contenido.classList.toggle("pointer-events-none", !visible);
          contenido.classList.toggle("absolute", !visible);
          contenido.classList.toggle("opacity-0", !visible);
          contenido.classList.toggle("inset-x-0", !visible);
          contenido.classList.toggle("top-1/2", !visible);
          contenido.classList.toggle("-translate-y-1/2", !visible);
        });
      };
      carrusel.addEventListener("carrusel:change", (event) => {
        const indice = (event as CustomEvent<{ indice: number }>).detail.indice;
        mostrar(indice);
      });
    });
</script>
