---
import HeroInterno from "./HeroInterno.astro";
import EncabezadoFormulario from "./EncabezadoFormulario.astro";
import { modalidadesTitulacion } from "../datos/titulacion";

const opcionesTitulacion = modalidadesTitulacion.filter(
  ({ nivel }) => nivel === "Licenciatura" || nivel === "Graduación directa",
);

const imagenesHero = [
  {
    src: "/heroes/egresados-informatica-sistemas-2022.webp",
    alt: "Egresados de Informática y Sistemas durante su acto de graduación en 2022.",
    nombre: "Promoción de egresados 2022",
  },
];
---

<HeroInterno
  migas={[{ texto: "Inicio", href: "/" }, { texto: "Egresados" }]}
  imagenes={imagenesHero}
  titulo="Tu experiencia fortalece nuestra carrera."
  descripcion="Comparte tu trayectoria profesional y mantente conectado con la carrera."
  labelledby="egresados-titulo"
  detalleTitulo="Proceso de registro"
  detalleItems={[
    "Consulta tus datos académicos.",
    "Completa tu información profesional.",
    "Envía tu registro a la carrera.",
  ]}
>
  <button
    slot="accion"
    class="boton-principal"
    type="button"
    data-open-registration
  >
    Iniciar mi registro <span aria-hidden="true">↓</span>
  </button>
</HeroInterno>

<dialog
  class="registro-modal w-[min(100%_-_2rem,56rem)] max-w-none overflow-visible border border-line bg-paper p-0 text-ink shadow-[0_24px_80px_rgb(0_0_0_/_45%)] backdrop:bg-[rgb(3_10_16_/_78%)] backdrop:backdrop-blur-sm"
  data-registration-dialog
  aria-labelledby="registro-titulo"
>
  <div class="max-h-[min(90svh,54rem)] overflow-y-auto p-5 sm:p-8">
    <div
      class="mb-6 flex items-start justify-between gap-5 border-b border-line pb-5"
    >
      <div>
        <p class="mb-2 text-xs font-bold tracking-[.14em] text-sky uppercase">
          Registro de egresados
        </p>
        <h2
          id="registro-titulo"
          class="mb-3 font-heading text-3xl font-semibold leading-tight"
        >
          Registra tu trayectoria.
        </h2>
        <p class="m-0 max-w-2xl text-sm leading-6 text-muted">
          Completa tus datos para mantenerte conectado.
        </p>
      </div>
      <button
        class="grid size-10 shrink-0 place-items-center rounded-full border border-line text-xl text-muted transition-colors hover:border-sky hover:text-sky focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        type="button"
        data-close-registration
        aria-label="Cerrar formulario">×</button
      >
    </div>

    <form id="consulta-egresado" class="grid gap-6" novalidate>
      <div>
        <label class="mb-2 block text-sm font-semibold" for="numero-registro"
          >Número de registro</label
        >
        <div class="flex gap-3 max-[520px]:flex-col">
          <input
            class="min-w-0 flex-1 border border-line bg-paper px-4 py-3 text-ink outline-none transition-colors placeholder:text-muted focus:border-sky focus:ring-2 focus:ring-sky/30"
            id="numero-registro"
            name="registro"
            autocomplete="off"
            inputmode="numeric"
            pattern="[0-9]{10}"
            minlength="10"
            maxlength="10"
            placeholder="Ejemplo: 2212345678"
            required
          />
          <button class="boton-principal justify-center" type="submit"
            >Buscar mis datos <span aria-hidden="true">→</span></button
          >
        </div>
      </div>
      <p
        class="m-0 text-sm text-muted empty:hidden"
        data-lookup-status
        aria-live="polite"
      >
      </p>
    </form>

    <div class="mt-6 hidden" data-registration-wrapper>
      <div
        class="mb-6 flex items-start justify-between gap-4 border border-sky/30 bg-brand-deep/60 p-4 max-[520px]:flex-col"
        data-profile-summary
      >
      </div>

      <form id="registro-egresado" class="grid gap-6" novalidate>
        <input type="hidden" name="tokenPreRegistro" data-registration-token />

        <fieldset class="grid gap-5 border-0 border-t border-line pt-6 p-0">
          <EncabezadoFormulario
            titulo="Datos personales"
            descripcion="Comparte tus datos de contacto y residencia actual. Los campos marcados con * son obligatorios."
          />
          <div
            class="grid grid-cols-3 gap-5 max-[820px]:grid-cols-2 max-[620px]:grid-cols-1"
          >
            <div>
              <label class="mb-2 block text-sm font-semibold" for="sexo">
                Sexo <span class="text-accent" aria-hidden="true">*</span>
              </label>
              <select class="campo-formulario" id="sexo" name="sexo" required>
                <option value="">Selecciona una opción</option>
                <option value="F">Femenino</option>
                <option value="M">Masculino</option>
              </select>
            </div>
            <div>
              <label
                class="mb-2 block text-sm font-semibold"
                for="fecha-nacimiento"
              >
                Fecha de nacimiento <span class="text-accent" aria-hidden="true"
                  >*</span
                >
              </label>
              <input
                class="campo-formulario"
                id="fecha-nacimiento"
                name="fechaNacimiento"
                type="date"
                required
              />
            </div>
            <div>
              <label
                class="mb-2 block text-sm font-semibold"
                for="ciudad-residencia"
              >
                Ciudad de residencia actual <span
                  class="text-accent"
                  aria-hidden="true">*</span
                >
              </label>
              <input
                class="campo-formulario"
                id="ciudad-residencia"
                name="ciudadRadicacion"
                autocomplete="address-level2"
                placeholder="Ej.: Camiri"
                required
              />
            </div>
            <div>
              <label class="mb-2 block text-sm font-semibold" for="celular">
                Celular o WhatsApp <span class="text-accent" aria-hidden="true"
                  >*</span
                >
              </label>
              <div class="flex">
                <span
                  class="flex items-center gap-2 border border-r-0 border-line bg-tint px-3 text-sm text-muted"
                  aria-label="Código de Bolivia"
                >
                  <span class="bandera-bolivia" aria-hidden="true"></span>
                  <span>+591</span>
                </span>
                <input
                  class="campo-formulario min-w-0"
                  id="celular"
                  name="celular"
                  type="tel"
                  inputmode="numeric"
                  autocomplete="tel-national"
                  pattern="[0-9]{8}"
                  maxlength="8"
                  placeholder="70000000"
                  required
                />
              </div>
            </div>
            <div class="col-span-2 max-[620px]:col-span-1">
              <label
                class="mb-2 block text-sm font-semibold"
                for="correo-personal"
              >
                Correo electrónico personal <span
                  class="text-accent"
                  aria-hidden="true">*</span
                >
              </label>
              <input
                class="campo-formulario"
                id="correo-personal"
                name="correoPersonal"
                type="email"
                autocomplete="email"
                placeholder="nombre@correo.com"
                required
              />
            </div>
          </div>
        </fieldset>

        <fieldset
          class="grid gap-5 border-0 border-t border-line pt-6 p-0"
          data-careers-fieldset
        >
          <EncabezadoFormulario
            titulo="Información académica"
            descripcion="Completa el año de egreso y la modalidad de titulación para cada carrera registrada."
          />
          <div class="grid gap-4" data-careers></div>
        </fieldset>

        <fieldset class="grid gap-5 border-0 border-t border-line pt-6 p-0">
          <EncabezadoFormulario
            titulo="Situación profesional"
            descripcion="Indica tu ocupación actual y completa la información relacionada."
          />
          <div class="grid grid-cols-2 gap-5 max-[620px]:grid-cols-1">
            <div data-labor-field="ocupacion">
              <label
                class="mb-2 block text-sm font-semibold"
                for="ocupacion-actual"
                >Ocupación actual <span class="text-accent" aria-hidden="true"
                  >*</span
                ></label
              >
              <select
                class="campo-formulario"
                id="ocupacion-actual"
                name="ocupacionActual"
                required
              >
                <option value="">Selecciona una opción</option>
                <option value="DEPENDIENTE">Trabajo dependiente</option>
                <option value="INDEPENDIENTE">Trabajo independiente</option>
                <option value="DESEMPLEADO">Desempleado</option>
                <option value="POSGRADO">Estudiante de posgrado</option>
                <option value="OTRO">Otro</option>
              </select>
            </div>
            <div data-labor-field="empresa">
              <label class="mb-2 block text-sm font-semibold" for="empresa"
                >Empresa u organización <span
                  class="text-accent"
                  aria-hidden="true">*</span
                ></label
              >
              <input
                class="campo-formulario"
                id="empresa"
                name="empresa"
                placeholder="Ej.: Empresa o institución"
              />
            </div>
            <div data-labor-field="cargo">
              <label class="mb-2 block text-sm font-semibold" for="cargo"
                >Cargo o puesto <span class="text-accent" aria-hidden="true"
                  >*</span
                ></label
              >
              <input
                class="campo-formulario"
                id="cargo"
                name="cargo"
                placeholder="Ej.: Analista de sistemas"
              />
            </div>
            <div data-labor-field="celularEmpresa">
              <label
                class="mb-2 block text-sm font-semibold"
                for="celular-empresa"
                >Celular de la empresa <span
                  class="text-accent"
                  aria-hidden="true">*</span
                ></label
              >
              <input
                class="campo-formulario"
                id="celular-empresa"
                name="celularEmpresa"
                type="tel"
                inputmode="numeric"
                placeholder="70000000"
              />
            </div>
            <div data-labor-field="correoEmpresa">
              <label
                class="mb-2 block text-sm font-semibold"
                for="correo-empresa"
                >Correo empresarial <span class="text-accent" aria-hidden="true"
                  >*</span
                ></label
              >
              <input
                class="campo-formulario"
                id="correo-empresa"
                name="correoEmpresa"
                type="email"
                placeholder="contacto@empresa.com"
              />
            </div>
          </div>
          <p
            class="m-0 text-sm leading-6 text-muted"
            data-occupation-help
            hidden
          >
          </p>
        </fieldset>

        <div class="border-t border-line pt-6">
          <label
            class="flex items-start gap-3 px-1 text-sm leading-6 text-muted"
          >
            <input
              class="mt-1 size-4 accent-[var(--color-sky)]"
              name="aceptacion"
              type="checkbox"
              required
            />
            <span
              >Autorizo el uso de mis datos para seguimiento, evaluación
              institucional y comunicaciones académicas o profesionales.</span
            >
          </label>
          <p
            class="mt-3 min-h-0 text-sm text-muted empty:hidden"
            data-registration-status
            aria-live="polite"
          >
          </p>
          <button
            class="boton-principal mt-3 w-full justify-center"
            type="submit"
            disabled
            >Enviar mi registro <span aria-hidden="true">→</span></button
          >
        </div>
      </form>
      <div
        class="forma-acento hidden border border-sky/30 bg-sky/10 px-0 py-6 text-center sm:py-8"
        data-registration-success
        role="status"
        aria-live="polite"
      >
        <p class="mb-3 text-3xl text-sky" aria-hidden="true">✓</p>
        <h3 class="mb-3 font-heading text-2xl font-semibold text-ice">
          ¡Registro completado!
        </h3>
        <p class="mx-auto mb-6 max-w-lg text-sm leading-6 text-muted">
          Gracias por compartir tu información y seguir conectado con la
          carrera.
        </p>
        <button
          class="grid size-10 place-items-center rounded-full border border-line text-xl text-muted transition-colors hover:border-sky hover:text-sky focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky"
          type="button"
          data-new-registration
          aria-label="Buscar otro registro"
          title="Buscar otro registro"
        >
          <span aria-hidden="true">↻</span>
        </button>
      </div>
    </div>
  </div>
</dialog>

<script
  type="application/json"
  id="opciones-titulacion-egresados"
  set:html={JSON.stringify(opcionesTitulacion)}
/>

<script>
  type CarreraPrellenado = {
    codigoCarrera: string;
    carrera: string;
    plan: string;
    tipoCarrera: "ORG" | "PAR";
  };

  type DatosPrellenado = {
    nroRegistro: string;
    documentoIdentidad: string;
    nombre: string;
    celular: string | null;
    carreras: CarreraPrellenado[];
  };

  type RespuestaPrellenado = {
    datos?: { datos?: DatosPrellenado; token?: string };
    mensaje?: string;
    exito?: boolean;
  };

  type OpcionTitulacion = {
    nivel: string;
    opciones: string[];
  };

  const gruposTitulacion = JSON.parse(
    document.querySelector("#opciones-titulacion-egresados")?.textContent ??
      "[]",
  ) as OpcionTitulacion[];

  const apiBase = import.meta.env.PUBLIC_EGRESADOS_API_URL?.replace(/\/$/, "");
  const lookupForm =
    document.querySelector<HTMLFormElement>("#consulta-egresado");
  const registrationForm =
    document.querySelector<HTMLFormElement>("#registro-egresado");
  const registrationDialog = document.querySelector<HTMLDialogElement>(
    "[data-registration-dialog]",
  );
  const openRegistration = document.querySelector<HTMLButtonElement>(
    "[data-open-registration]",
  );
  const closeRegistration = document.querySelector<HTMLButtonElement>(
    "[data-close-registration]",
  );
  const registrationWrapper = document.querySelector<HTMLElement>(
    "[data-registration-wrapper]",
  );
  const lookupStatus = document.querySelector<HTMLElement>(
    "[data-lookup-status]",
  );
  const registrationStatus = document.querySelector<HTMLElement>(
    "[data-registration-status]",
  );
  const registrationSuccess = document.querySelector<HTMLElement>(
    "[data-registration-success]",
  );
  const newRegistration = document.querySelector<HTMLButtonElement>(
    "[data-new-registration]",
  );
  const profileSummary = document.querySelector<HTMLElement>(
    "[data-profile-summary]",
  );
  const careersContainer =
    document.querySelector<HTMLElement>("[data-careers]");
  const tokenInput = document.querySelector<HTMLInputElement>(
    "[data-registration-token]",
  );
  const registrationSubmitButton =
    registrationForm?.querySelector<HTMLButtonElement>("button[type=submit]");

  const updateRegistrationButton = () => {
    if (!registrationSubmitButton || !registrationForm) return;
    if (registrationSubmitButton.getAttribute("aria-busy") !== "true") {
      registrationSubmitButton.disabled = !registrationForm.checkValidity();
    }
  };

  registrationForm?.addEventListener("input", updateRegistrationButton);
  registrationForm?.addEventListener("change", updateRegistrationButton);

  const mostrarExito = () => {
    registrationForm?.reset();
    registrationForm?.classList.add("hidden");
    profileSummary?.classList.add("hidden");
    registrationSuccess?.classList.remove("hidden");
  };

  openRegistration?.addEventListener("click", () => {
    registrationDialog?.showModal();
    document.querySelector<HTMLInputElement>("#numero-registro")?.focus();
  });

  closeRegistration?.addEventListener("click", () =>
    registrationDialog?.close(),
  );
  registrationDialog?.addEventListener("cancel", (event) => {
    event.preventDefault();
  });

  const setStatus = (
    element: HTMLElement | null,
    message: string,
    error = false,
  ) => {
    if (!element) return;
    element.textContent = message;
    element.classList.toggle("text-accent", error);
    element.classList.toggle("text-muted", !error);
  };

  const occupationSelect =
    document.querySelector<HTMLSelectElement>("#ocupacion-actual");
  const occupationHelp = document.querySelector<HTMLElement>(
    "[data-occupation-help]",
  );
  const celularInput = document.querySelector<HTMLInputElement>("#celular");
  const laborFields = Array.from(
    document.querySelectorAll<HTMLElement>("[data-labor-field]"),
  );

  const updateLaborFields = () => {
    const occupation = occupationSelect?.value ?? "";
    const occupationMessages: Record<string, string> = {
      DEPENDIENTE:
        "Completa los datos de la organización donde trabajas y sus medios de contacto.",
      INDEPENDIENTE: "Indica la actividad o negocio que realizas actualmente.",
      DESEMPLEADO: "No se requieren datos laborales adicionales.",
      POSGRADO: "Indica la institución o programa de posgrado que cursas.",
      OTRO: "Describe brevemente tu actividad actual.",
    };
    if (occupationHelp) {
      occupationHelp.textContent = occupationMessages[occupation] ?? "";
      occupationHelp.hidden = !occupation;
    }
    const visibleFields: Record<string, boolean> = {
      ocupacion: true,
      empresa: ["DEPENDIENTE", "INDEPENDIENTE", "POSGRADO", "OTRO"].includes(
        occupation,
      ),
      cargo: ["DEPENDIENTE", "INDEPENDIENTE", "POSGRADO", "OTRO"].includes(
        occupation,
      ),
      celularEmpresa: occupation === "DEPENDIENTE",
      correoEmpresa: occupation === "DEPENDIENTE",
    };

    laborFields.forEach((field) => {
      const key = field.dataset.laborField ?? "";
      const visible = visibleFields[key] ?? false;
      field.hidden = !visible;
      field.setAttribute("aria-hidden", String(!visible));
      field.querySelectorAll<HTMLInputElement>("input").forEach((input) => {
        input.required = visible;
        if (!visible) {
          input.value = "";
        }
      });
    });
  };

  occupationSelect?.addEventListener("change", updateLaborFields);
  updateLaborFields();

  const normalizarCelularBolivia = (value: string) => {
    const digits = value.replace(/\D/g, "");
    return (digits.startsWith("591") ? digits.slice(3) : digits).slice(0, 8);
  };

  celularInput?.addEventListener("input", () => {
    celularInput.value = normalizarCelularBolivia(celularInput.value);
  });

  const resetRegistration = () => {
    lookupForm?.reset();
    registrationForm?.reset();
    lookupForm?.classList.remove("hidden");
    registrationWrapper?.classList.add("hidden");
    registrationForm?.classList.remove("hidden");
    registrationSuccess?.classList.add("hidden");
    profileSummary?.classList.remove("hidden");
    careersContainer?.replaceChildren();
    if (tokenInput) tokenInput.value = "";
    if (profileSummary) profileSummary.replaceChildren();
    updateLaborFields();
    setButtonLoading(
      lookupForm?.querySelector<HTMLButtonElement>("button[type=submit]") ??
        null,
      false,
      "",
    );
    setButtonLoading(
      registrationForm?.querySelector<HTMLButtonElement>(
        "button[type=submit]",
      ) ?? null,
      false,
      "",
    );
    updateRegistrationButton();
    setStatus(lookupStatus, "");
    setStatus(registrationStatus, "");
  };

  registrationDialog?.addEventListener("close", resetRegistration);
  newRegistration?.addEventListener("click", () => {
    resetRegistration();
    document.querySelector<HTMLInputElement>("#numero-registro")?.focus();
  });

  const setButtonLoading = (
    button: HTMLButtonElement | null,
    loading: boolean,
    label: string,
  ) => {
    if (!button) return;
    if (loading) {
      button.dataset.defaultContent ??= button.innerHTML;
      button.disabled = true;
      button.setAttribute("aria-busy", "true");
      button.innerHTML = `<span class="spinner-accion" aria-hidden="true"></span>${label}`;
    } else {
      button.disabled = false;
      button.removeAttribute("aria-busy");
      if (button.dataset.defaultContent) {
        button.innerHTML = button.dataset.defaultContent;
      }
    }
  };

  const createInput = (
    labelText: string,
    name: string,
    type: string,
    required = true,
  ) => {
    const wrapper = document.createElement("div");
    const label = document.createElement("label");
    const input = document.createElement("input");
    label.className = "mb-2 block text-sm font-semibold";
    label.htmlFor = `carrera-${name}`;
    label.textContent = labelText;
    if (required) {
      const mark = document.createElement("span");
      mark.className = "text-accent";
      mark.setAttribute("aria-hidden", "true");
      mark.textContent = " *";
      label.append(mark);
    }
    input.className = "campo-formulario";
    input.id = `carrera-${name}`;
    input.name = name;
    input.type = type;
    if (type === "number" || type === "tel") {
      input.inputMode = "numeric";
    }
    input.required = required;
    wrapper.append(label, input);
    return wrapper;
  };

  const createTitulacionSelect = (index: number) => {
    const wrapper = document.createElement("div");
    const label = document.createElement("label");
    const select = document.createElement("select");
    label.className = "mb-2 block text-sm font-semibold";
    label.htmlFor = `carrera-modalidad-${index}`;
    label.textContent = "Modalidad de titulación";
    const mark = document.createElement("span");
    mark.className = "text-accent";
    mark.setAttribute("aria-hidden", "true");
    mark.textContent = " *";
    label.append(mark);
    select.className = "campo-formulario";
    select.id = `carrera-modalidad-${index}`;
    select.name = `carreras[${index}][modalidadTitulacion]`;
    select.required = true;
    const placeholder = document.createElement("option");
    placeholder.value = "";
    placeholder.textContent = "Selecciona una opción";
    select.append(placeholder);
    gruposTitulacion.forEach((grupo) => {
      grupo.opciones.forEach((opcion) => {
        const option = document.createElement("option");
        option.value = opcion;
        option.textContent = opcion;
        select.append(option);
      });
    });
    wrapper.append(label, select);
    return wrapper;
  };

  const showCareerFields = (carreras: CarreraPrellenado[]) => {
    if (!careersContainer) return;
    careersContainer.replaceChildren();
    carreras.forEach((carrera, index) => {
      const card = document.createElement("article");
      const title = document.createElement("h3");
      const codeLabel = document.createElement("span");
      const careerName = document.createElement("span");
      const careerType = document.createElement("span");
      const fields = document.createElement("div");
      const code = document.createElement("input");
      const plan = document.createElement("input");
      const type = document.createElement("input");

      card.className = "border border-line bg-paper p-4";
      title.className =
        "mb-4 flex flex-wrap items-baseline gap-x-3 gap-y-1 font-semibold";
      codeLabel.className =
        "whitespace-nowrap text-sm font-bold tracking-wide text-sky";
      codeLabel.textContent = `${carrera.codigoCarrera}-${carrera.plan}`;
      careerName.textContent = carrera.carrera;
      careerType.className =
        "rounded-full border border-line bg-tint px-2 py-0.5 text-xs font-semibold tracking-wide text-muted";
      careerType.textContent =
        carrera.tipoCarrera === "PAR"
          ? "Carrera paralela"
          : "Carrera de origen";
      fields.className = "grid grid-cols-2 gap-4 max-[620px]:grid-cols-1";
      code.type = "hidden";
      code.name = `carreras[${index}][codigoCarrera]`;
      code.value = carrera.codigoCarrera;
      plan.type = "hidden";
      plan.name = `carreras[${index}][plan]`;
      plan.value = carrera.plan;
      type.type = "hidden";
      type.name = `carreras[${index}][tipoCarrera]`;
      type.value = carrera.tipoCarrera;

      const year = createInput(
        "Año de egreso",
        `carreras[${index}][anioEgreso]`,
        "number",
      );
      const modality = createTitulacionSelect(index);
      const yearInput = year.querySelector<HTMLInputElement>("input");
      yearInput?.setAttribute("min", "1900");
      yearInput?.setAttribute("max", String(new Date().getFullYear()));
      yearInput?.setAttribute("step", "1");
      yearInput?.setAttribute("placeholder", "2022");
      fields.append(year, modality);
      title.append(codeLabel, careerName, careerType);
      card.append(title, code, plan, type, fields);
      careersContainer.append(card);
    });
  };

  const setFormValue = (name: string, value: string | null | undefined) => {
    const field = registrationForm?.elements.namedItem(name);
    if (field instanceof HTMLInputElement && value) {
      field.value =
        name === "celular" ? normalizarCelularBolivia(value) : value;
    }
  };

  lookupForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const registro = new FormData(lookupForm)
      .get("registro")
      ?.toString()
      .trim();
    if (!registro) {
      setStatus(
        lookupStatus,
        "Escribe tu número de registro para continuar.",
        true,
      );
      return;
    }
    if (!/^\d{10}$/.test(registro)) {
      setStatus(
        lookupStatus,
        "El número de registro debe tener exactamente 10 dígitos.",
        true,
      );
      return;
    }

    const button = lookupForm.querySelector<HTMLButtonElement>(
      "button[type=submit]",
    );
    setButtonLoading(button, true, "Buscando…");
    setStatus(lookupStatus, "Buscando tus datos oficiales…");
    registrationWrapper?.classList.add("hidden");

    try {
      if (!apiBase) {
        throw new Error("El servicio de egresados no está configurado.");
      }
      const response = await fetch(
        `${apiBase}/egresados/prellenado/${encodeURIComponent(registro)}`,
      );
      const result = (await response.json()) as RespuestaPrellenado;
      const prellenado = result.datos?.datos;
      const token = result.datos?.token;

      if (!response.ok || !prellenado || !token) {
        throw new Error(
          response.status === 404
            ? "No encontramos un egresado con ese número de registro."
            : (result.mensaje ?? "No fue posible consultar tus datos."),
        );
      }

      if (profileSummary) {
        profileSummary.replaceChildren();
        const title = document.createElement("p");
        const details = document.createElement("div");
        const registro = document.createElement("span");
        const separator = document.createElement("span");
        const documento = document.createElement("span");
        const profileInfo = document.createElement("div");
        const newSearch = document.createElement("button");
        title.className = "mb-1 font-semibold text-ice";
        title.textContent = prellenado.nombre;
        details.className =
          "flex flex-wrap items-center gap-x-3 text-sm leading-6 text-muted";
        registro.textContent = `Nro. de registro: ${prellenado.nroRegistro}`;
        separator.textContent = "·";
        separator.setAttribute("aria-hidden", "true");
        documento.textContent = `C.I.: ${prellenado.documentoIdentidad}`;
        profileInfo.className = "min-w-0";
        newSearch.className =
          "grid size-9 shrink-0 place-items-center rounded-full border border-line text-xl text-muted transition-colors hover:border-sky hover:text-sky focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky";
        newSearch.type = "button";
        newSearch.setAttribute("aria-label", "Buscar otro registro");
        newSearch.title = "Buscar otro registro";
        newSearch.innerHTML = '<span aria-hidden="true">↻</span>';
        newSearch.addEventListener("click", () => {
          resetRegistration();
          document.querySelector<HTMLInputElement>("#numero-registro")?.focus();
        });
        details.append(registro, separator, documento);
        profileInfo.append(title, details);
        profileSummary.append(profileInfo, newSearch);
      }

      if (tokenInput) tokenInput.value = token;
      showCareerFields(prellenado.carreras);
      setFormValue("celular", prellenado.celular);
      lookupForm.classList.add("hidden");
      registrationWrapper?.classList.remove("hidden");
      setStatus(
        lookupStatus,
        "Datos encontrados. Completa el formulario para finalizar tu registro.",
      );
      registrationWrapper?.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    } catch (error) {
      setStatus(
        lookupStatus,
        error instanceof Error
          ? error.message
          : "No fue posible conectar con el servicio.",
        true,
      );
    } finally {
      setButtonLoading(button, false, "");
      updateRegistrationButton();
    }
  });

  registrationForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!registrationForm.reportValidity()) return;
    const formData = new FormData(registrationForm);
    const carreras = Array.from(
      document.querySelectorAll<HTMLInputElement>(
        "[name^='carreras'][name$='[codigoCarrera]']",
      ),
    ).map((codeField) => {
      const match = codeField.name.match(/carreras\[(\d+)\]/);
      const index = match?.[1] ?? "0";
      const value = (name: string) =>
        (
          registrationForm.elements.namedItem(
            `carreras[${index}][${name}]`,
          ) as HTMLInputElement
        )?.value ?? "";
      return {
        codigoCarrera: value("codigoCarrera"),
        plan: value("plan"),
        tipoCarrera: value("tipoCarrera"),
        anioEgreso: Number(value("anioEgreso")),
        modalidadTitulacion: value("modalidadTitulacion"),
      };
    });
    const payload = {
      tokenPreRegistro: formData.get("tokenPreRegistro"),
      sexo: formData.get("sexo"),
      fechaNacimiento: formData.get("fechaNacimiento") || null,
      ocupacionActual: formData.get("ocupacionActual") || null,
      empresa: formData.get("empresa") || null,
      cargo: formData.get("cargo") || null,
      ciudadRadicacion: formData.get("ciudadRadicacion") || null,
      celular: formData.get("celular")
        ? normalizarCelularBolivia(formData.get("celular")?.toString() ?? "")
        : null,
      celularEmpresa: formData.get("celularEmpresa") || null,
      correoPersonal: formData.get("correoPersonal") || null,
      correoEmpresa: formData.get("correoEmpresa") || null,
      carreras,
    };
    const button = registrationForm.querySelector<HTMLButtonElement>(
      "button[type=submit]",
    );
    setButtonLoading(button, true, "Enviando…");

    try {
      if (!apiBase) {
        throw new Error("El servicio de egresados no está configurado.");
      }
      const response = await fetch(`${apiBase}/egresados`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const result = (await response.json()) as {
        mensaje?: string;
        exito?: boolean;
      };
      if (!response.ok) {
        throw new Error(
          response.status === 409
            ? "Este egresado ya se encuentra registrado."
            : (result.mensaje ?? "No fue posible completar el registro."),
        );
      }
      mostrarExito();
    } catch (error) {
      setStatus(
        registrationStatus,
        error instanceof Error
          ? error.message
          : "No fue posible conectar con el servicio.",
        true,
      );
    } finally {
      setButtonLoading(button, false, "");
      updateRegistrationButton();
    }
  });
</script>
