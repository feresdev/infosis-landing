---
interface Props {
  id?: string;
}

const { id = "resplandor-circuitos" } = Astro.props;
---

<svg
  class="pointer-events-none absolute inset-0 z-0 h-full w-full"
  viewBox="0 0 900 700"
  preserveAspectRatio="xMidYMid meet"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <radialGradient id={id}>
      <stop stop-color="var(--color-sky)" stop-opacity=".3"></stop>
      <stop offset="1" stop-color="var(--color-sky)" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  <circle cx="450" cy="350" r="230" fill={`url(#${id})`}></circle>
  <g
    class="lineas-circuito"
    stroke="var(--color-sky)"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M0 90h170v36h55v45h45" stroke-opacity=".55"></path>
    <path d="M900 90H730v36h-55v45h-45" stroke-opacity=".55"></path>
    <path d="M0 150h130v60h90v45h60" stroke-opacity=".6"></path>
    <path d="M900 150H770v60h-90v45h-60" stroke-opacity=".6"></path>
    <path class="flujo-circuito" d="M0 150h130v60h90v45h60"></path>
    <path
      class="flujo-circuito flujo-circuito-secundario"
      d="M900 150H770v60h-90v45h-60"></path>
    <path
      class="flujo-circuito flujo-circuito-terciario"
      d="M0 550h120v-70h100v-40h60"></path>
    <path
      class="flujo-circuito flujo-circuito-cuaternario"
      d="M900 550H780v-70H680v-40h-60"></path>
  </g>
  <g fill="var(--color-sky)">
    <circle class="nodo-circuito" cx="170" cy="90" r="4"></circle>
    <circle class="nodo-circuito nodo-circuito-dos" cx="730" cy="90" r="4"
    ></circle>
    <circle class="nodo-circuito" cx="280" cy="255" r="4"></circle>
    <circle class="nodo-circuito nodo-circuito-dos" cx="620" cy="255" r="4"
    ></circle>
    <circle class="nodo-circuito" cx="150" cy="566" r="4"></circle>
    <circle class="nodo-circuito nodo-circuito-dos" cx="750" cy="566" r="4"
    ></circle>
  </g>
</svg>
