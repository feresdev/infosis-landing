---
interface ImagenCarrusel {
  src: string;
  alt: string;
  nombre: string;
}

interface Props {
  imagenes: ImagenCarrusel[];
  id?: string;
  labelledby: string;
  class?: string;
  etiquetaControl?: string;
}

const {
  imagenes,
  id,
  labelledby,
  class: className,
  etiquetaControl = "imagen",
} = Astro.props;
const tieneVariasImagenes = imagenes.length > 1;
---

<section
  class:list={[
    "fondo-institucional relative flex min-h-[clamp(42rem,calc(100svh-72px),52rem)] items-center overflow-hidden border-b border-line text-ice max-[820px]:min-h-[clamp(32rem,calc(84svh-105px),44rem)]",
    className,
  ]}
  id={id}
  aria-labelledby={labelledby}
  data-carrusel-base
>
  <div
    class="pointer-events-none absolute inset-0 z-0 overflow-hidden"
    aria-hidden="true"
  >
    {
      imagenes.map((imagen, indice) => (
        <div
          class="hero-slide absolute inset-0 bg-cover bg-center"
          style={`background-image: url("${imagen.src}")`}
          role="img"
          aria-label={imagen.alt}
          data-carrusel-slide
          data-active={indice === 0 ? "true" : "false"}
          data-label={imagen.nombre}
        />
      ))
    }
  </div>
  <div
    class="hero-capa pointer-events-none absolute inset-0 z-[1]"
    aria-hidden="true"
  >
  </div>
  <slot />
  {
    tieneVariasImagenes && (
      <>
        <div class="pointer-events-none absolute inset-x-0 top-1/2 z-20 flex -translate-y-1/2 items-center justify-between px-[clamp(1rem,4vw,3rem)] max-[820px]:hidden">
          <button
            class="pointer-events-auto grid size-10 cursor-pointer place-items-center rounded-full border border-sky/30 bg-brand-deep/65 text-ice backdrop-blur-sm transition-colors hover:bg-brand-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky"
            type="button"
            data-carrusel-previous
            aria-label={`Mostrar ${etiquetaControl} anterior`}
          >
            <svg
              viewBox="0 0 24 24"
              class="size-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="m15 18-6-6 6-6" />
            </svg>
          </button>
          <button
            class="pointer-events-auto grid size-10 cursor-pointer place-items-center rounded-full border border-sky/30 bg-brand-deep/65 text-ice backdrop-blur-sm transition-colors hover:bg-brand-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky"
            type="button"
            data-carrusel-next
            aria-label={`Mostrar ${etiquetaControl} siguiente`}
          >
            <svg
              viewBox="0 0 24 24"
              class="size-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path d="m9 18 6-6-6-6" />
            </svg>
          </button>
        </div>
        <div
          class="forma-acento absolute bottom-7 left-1/2 z-20 flex -translate-x-1/2 items-center gap-3 border border-sky/25 bg-brand-deep/65 px-4 py-2 backdrop-blur-sm max-[820px]:hidden"
          role="group"
          aria-label={`Elegir ${etiquetaControl}`}
        >
          {imagenes.map((imagen, indice) => (
            <button
              class="hero-indicador size-2.5 cursor-pointer rounded-full bg-ice/55 transition-[background-color,transform] hover:bg-ice"
              type="button"
              data-carrusel-go-to={indice}
              aria-label={`Mostrar ${etiquetaControl}: ${imagen.nombre}`}
              aria-pressed={indice === 0 ? "true" : "false"}
            />
          ))}
        </div>
      </>
    )
  }
  {
    imagenes.length > 0 && (
      <span
        class="sr-only"
        data-carrusel-status
        data-carrusel-label={etiquetaControl}
        aria-live="polite"
        aria-atomic="true"
      >
        {etiquetaControl} 1 de {imagenes.length}: {imagenes[0].nombre}
      </span>
    )
  }
</section>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-carrusel-base]")
    .forEach((carrusel) => {
      const slides = Array.from(
        carrusel.querySelectorAll<HTMLElement>("[data-carrusel-slide]"),
      );
      const indicadores = Array.from(
        carrusel.querySelectorAll<HTMLButtonElement>("[data-carrusel-go-to]"),
      );
      const estado = carrusel.querySelector<HTMLElement>(
        "[data-carrusel-status]",
      );
      const etiqueta = estado?.dataset.carruselLabel ?? "Elemento";
      let activa = 0;

      const mostrar = (indice: number) => {
        if (slides.length === 0) return;
        activa = (indice + slides.length) % slides.length;
        slides.forEach((slide, posicion) => {
          slide.dataset.active = String(posicion === activa);
        });
        indicadores.forEach((indicador, posicion) => {
          indicador.setAttribute("aria-pressed", String(posicion === activa));
        });
        if (estado) {
          estado.textContent = `${etiqueta} ${activa + 1} de ${slides.length}: ${slides[activa].dataset.label ?? ""}`;
        }
        carrusel.dispatchEvent(
          new CustomEvent("carrusel:change", { detail: { indice: activa } }),
        );
      };

      indicadores.forEach((indicador, indice) => {
        indicador.addEventListener("click", () => mostrar(indice));
      });
      carrusel
        .querySelector<HTMLButtonElement>("[data-carrusel-previous]")
        ?.addEventListener("click", () => mostrar(activa - 1));
      carrusel
        .querySelector<HTMLButtonElement>("[data-carrusel-next]")
        ?.addEventListener("click", () => mostrar(activa + 1));

      if (
        slides.length > 1 &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        window.setInterval(() => mostrar(activa + 1), 6000);
      }
    });
</script>
