---
import CarruselBase from "./CarruselBase.astro";

interface ImagenCarrusel {
  src: string;
  alt: string;
  nombre: string;
}

interface Props {
  imagenes: ImagenCarrusel[];
  id?: string;
  labelledby: string;
  class?: string;
}

const { imagenes, id, labelledby, class: className } = Astro.props;
---

<CarruselBase
  imagenes={imagenes}
  id={id}
  labelledby={labelledby}
  class={className}
  etiquetaControl="imagen"
>
  <slot />
</CarruselBase>
