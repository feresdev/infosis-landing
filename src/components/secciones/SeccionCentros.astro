---
import { centros } from "../../datos/centros";
import EncabezadoSeccion from "../EncabezadoSeccion.astro";
import TarjetaCentro from "../TarjetaCentro.astro";
---

<section
  class="seccion-institucional border-y border-line bg-paper"
  id="centros"
  aria-labelledby="centros-titulo"
>
  <div class="contenedor-pagina">
    <EncabezadoSeccion
      eyebrow="Centros y laboratorios"
      titulo="Espacios para aprender haciendo."
      descripcion="Conoce los espacios que apoyan tu formación, práctica e investigación."
      id="centros-titulo"
    />
    <div
      class="grid auto-rows-fr grid-cols-3 gap-5 max-[900px]:grid-cols-2 max-[720px]:grid-cols-1"
    >
      {centros.map((centro) => <TarjetaCentro centro={centro} />)}
    </div>
  </div>
</section>
