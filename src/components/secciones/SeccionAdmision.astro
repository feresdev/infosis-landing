---
import EncabezadoSeccion from "../EncabezadoSeccion.astro";
---

<section
  class="fondo-admision seccion-institucional border-y border-line text-ice"
  id="admision"
  aria-labelledby="admision-titulo"
>
  <div class="contenedor-pagina">
    <EncabezadoSeccion
      eyebrow="Admisión"
      titulo="¿Quieres estudiar con nosotros?"
      descripcion="Obtén información oficial sobre requisitos, fechas y proceso de ingreso a nuestras carreras."
      id="admision-titulo"
      tono="oscuro"
    />
    <div>
      <a
        class="boton-principal"
        href="https://wa.me/59176660753?text=Hola%2C%20quiero%20informaci%C3%B3n%20sobre%20los%20requisitos%2C%20fechas%20y%20proceso%20de%20admisi%C3%B3n%20para%20Ingenier%C3%ADa%20Inform%C3%A1tica%20e%20Ingenier%C3%ADa%20en%20Sistemas."
        target="_blank"
        rel="noreferrer"
      >
        Consultar por WhatsApp <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
