---
import CarruselPortada from "../CarruselPortada.astro";

const diapositivas = [
  {
    imagen: "/heroes/clase-universitaria.webp",
    alt: "Clase universitaria de la Dirección de Carrera.",
    nombre: "Clase universitaria",
    titulo: "Tecnología para",
    destacado: "transformar nuestro entorno.",
    descripcion:
      "Conoce la Dirección de Carrera de Informática y Sistemas, sus dos carreras, centros y actividades.",
    acciones: [
      { texto: "Explorar carreras", href: "#carreras" },
      { texto: "Ver actividades", href: "#galeria", secundaria: true },
    ],
  },
  {
    imagen: "/heroes/egresados-informatica-sistemas-2022.webp",
    alt: "Egresados de Informática y Sistemas durante su acto de graduación en 2022.",
    nombre: "Comunidad de egresados",
    titulo: "Egresados:",
    destacado: "comparte tu trayectoria profesional.",
    descripcion:
      "Registra dónde estás y qué haces para mantener el vínculo con la carrera y recibir futuras oportunidades.",
    acciones: [{ texto: "Registrarme como egresado", href: "/egresados" }],
  },
];
---

<CarruselPortada diapositivas={diapositivas} id="inicio" />
