---
import Layout from "../components/Layout.astro";
import BarraNavegacion from "../components/BarraNavegacion.astro";
import PiePagina from "../components/PiePagina.astro";
import Portada from "../components/secciones/Portada.astro";
import SeccionCarreras from "../components/secciones/SeccionCarreras.astro";
import SeccionCentros from "../components/secciones/SeccionCentros.astro";
import SeccionGaleria from "../components/secciones/SeccionGaleria.astro";
import SeccionVidaUniversitaria from "../components/secciones/SeccionVidaUniversitaria.astro";
import SeccionAdmision from "../components/secciones/SeccionAdmision.astro";
---

<Layout
  title="Ingeniería Informática e Ingeniería en Sistemas · FICH · UAGRM"
  description="Conoce Ingeniería Informática e Ingeniería en Sistemas de la FICH · UAGRM: carreras, centros, actividades, oportunidades y admisión en Camiri."
  imageAlt="Dirección de Carrera de Informática y Sistemas de la FICH · UAGRM"
>
  <BarraNavegacion />
  <main id="contenido">
    <Portada />
    <SeccionCarreras />
    <SeccionCentros />
    <SeccionVidaUniversitaria />
    <SeccionGaleria />
    <SeccionAdmision />
  </main>
  <PiePagina />
</Layout>
