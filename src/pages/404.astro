---
import PaginaInstitucional from "../components/PaginaInstitucional.astro";
import HeroEstado from "../components/HeroEstado.astro";
---

<PaginaInstitucional
  title="Página no encontrada · FICH · UAGRM"
  description="La página que buscas no está disponible en el sitio de Informática y Sistemas de la FICH · UAGRM."
  robots="noindex, nofollow"
>
  <HeroEstado
    codigo="404"
    titulo="Esta ruta"
    destacado="no existe."
    labelledby="error-titulo"
  >
    <a class="boton-principal" href="/"
      >Volver al inicio <span aria-hidden="true">↗</span></a
    >
    <a class="boton-secundario" href="/#carreras"
      >Explorar carreras <span aria-hidden="true">→</span></a
    >
  </HeroEstado>
</PaginaInstitucional>
